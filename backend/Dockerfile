# ==========================================
# المرحلة 1: بناء وتجميع المشروع (Build)
# ==========================================
FROM maven:3.9.6-eclipse-temurin-17-alpine AS build

# تحديد مجلد العمل داخل الحاوية
WORKDIR /app

# نسخ ملف إعدادات الاعتمادات pom.xml أولاً للاستفادة من الكاش
COPY pom.xml .

# تحميل الاعتمادات والمكتبات المطلوبة دون تجميع الكود
RUN mvn dependency:go-offline -B

# نسخ كود المشروع بالكامل
COPY src ./src

# بناء المشروع وإنتاج ملف الـ JAR التنفيذي وتخطي اختبارات الوحدة لتسريع العملية
RUN mvn  clean package -DskipTests

# ==========================================
# المرحلة 2: بيئة التشغيل الـ Runtime (خفيفة وسريعة)
# ==========================================
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# نسخ ملف الـ JAR الذي تم بناؤه في المرحلة الأولى
COPY --from=build /app/target/*.jar app.jar

# فتح المنفذ 8080 الذي يعمل عليه نظام Spring Boot الافتراضي
EXPOSE 8080

# أمر تشغيل التطبيق عند إقلاع الحاوية
ENTRYPOINT ["java", "-jar", "app.jar"]